@charset "utf-8";

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { min-height: 100vh; font-family: Arial, sans-serif; background: linear-gradient(135deg, rgb(18, 0, 8), rgb(75, 0, 24), rgb(18, 0, 8)); color: white; display: flex; justify-content: center; align-items: center; overflow: hidden; }

.container { width: 90%; max-width: 420px; text-align: center; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(15px); border-radius: 25px; padding: 35px 25px; box-shadow: rgba(255, 0, 80, 0.25) 0px 0px 40px; }

.heart { font-size: 60px; animation: 1.2s ease 0s infinite normal none running beat; margin-bottom: 15px; }

@keyframes beat { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

h1 { font-size: 28px; margin-bottom: 10px; }

.subtitle { color: rgb(255, 193, 211); margin-bottom: 25px; }

input { width: 100%; padding: 15px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; border-radius: 15px; text-align: center; font-size: 16px; background: rgba(255, 255, 255, 0.95); color: rgb(51, 51, 51); margin-bottom: 15px; }

button { width: 100%; padding: 15px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 15px; background: linear-gradient(45deg, rgb(255, 23, 79), rgb(255, 79, 129)); color: white; font-size: 17px; font-weight: bold; cursor: pointer; transition: 0.3s; }

button:active { transform: scale(0.96); }

#error { color: rgb(255, 139, 168); margin-top: 15px; min-height: 20px; }

#lovePage { display: none; }

.message { line-height: 2; font-size: 18px; color: rgb(255, 229, 237); margin-top: 20px; }

.signature { margin-top: 25px; font-size: 20px; color: rgb(255, 138, 170); font-weight: bold; }

.floating-heart { position: fixed; bottom: -30px; font-size: 25px; animation: 5s linear 0s 1 normal forwards running floatUp; pointer-events: none; }

@keyframes floatUp { 
  0% { transform: translateY(0px) rotate(0deg); opacity: 1; }
  100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
}
